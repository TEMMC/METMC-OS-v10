{
  "layer": "top",
  "position": "top",
  "height": 62,
  "spacing": 5,
  "margin-top": 4,
  "margin-left": 6,
  "margin-right": 6,
  "modules-left": ["custom/menu", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["network", "custom/audio", "custom/display", "battery", "tray"],
  "custom/menu": {
    "format": "METMC",
    "tooltip": "METMC OS — Applications and search",
    "on-click": "fuzzel --show drun"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 25,
    "icon-theme": "Adwaita",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "clock": {
    "format": "{:%a %d %b  |  %H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "network": {
    "format-wifi": "WIFI {essid}",
    "format-ethernet": "LAN",
    "format-disconnected": "OFFLINE",
    "tooltip": true,
    "on-click": "metmc-wifi open"
  },
  "custom/audio": {
    "format": "SOUND",
    "tooltip": "Open Android sound settings",
    "on-click": "metmc-settings sound"
  },
  "custom/display": {
    "format": "DISPLAY",
    "tooltip": "Open Android display and brightness settings",
    "on-click": "metmc-settings display"
  },
  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "CHG {capacity}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "states": {"warning": 25, "critical": 10},
    "tooltip": true
  },
  "tray": {"spacing": 8}
}
