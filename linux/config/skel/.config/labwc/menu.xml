<openbox_menu>
  <menu id="root-menu" label="METMC OS // TOOLS">
    <item label="Applications"><action name="Execute" command="fuzzel --show drun"/></item>
    <item label="Terminal"><action name="Execute" command="foot"/></item>
    <item label="Files"><action name="Execute" command="thunar"/></item>
    <separator />
    <item label="Network status"><action name="Execute" command="foot -e sh -lc 'ip addr; echo; ip route; echo; read -r -p Press-Enter'"/></item>
    <item label="System monitor"><action name="Execute" command="foot -e htop"/></item>
    <item label="METMC settings"><action name="Execute" command="metmc-settings"/></item>
    <separator />
    <item label="Reconfigure"><action name="Reconfigure"/></item>
    <item label="Exit desktop"><action name="Exit"/></item>
  </menu>
</openbox_menu>
